# PDFForge Environment Variables

# JWT
SECRET_KEY=your-super-secret-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/pdfforge.db

# File Storage
MAX_FILE_SIZE_MB=100
OCR_DPI=300

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Plans
FREE_CREDITS=5
FREE_MAX_PAGES=20
PRO_CREDITS=100
PRO_MAX_PAGES=500
ENTERPRISE_CREDITS=-1
ENTERPRISE_MAX_PAGES=-1
