{
  "name": "HTML to Word - PDFForge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "convert-html",
        "options": {},
        "responseMode": "lastNode"
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "convert-html"
    },
    {
      "parameters": {
        "jsCode": "const html = $input.first().json.html || $input.first().json.body?.html || $input.first().json.data || '';\nconst filename = $input.first().json.filename || $input.first().json.body?.filename || 'documento';\n\nif (!html) {\n  throw new Error('No se encontro campo \"html\" en el body del request');\n}\n\nconst htmlBuffer = Buffer.from(html, 'utf-8');\n\nreturn [{\n  json: { filename },\n  binary: {\n    file: {\n      data: htmlBuffer,\n      mimeType: 'text/html',\n      fileName: filename + '.html'\n    }\n  }\n}];"
      },
      "id": "2",
      "name": "Preparar HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://aimachristian-pdf.ajcxjb.easypanel.host/api/convert/html",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer TU_TOKEN_AQUI"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "3",
      "name": "Convert HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "4",
      "name": "Esperar",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [750, 0]
    },
    {
      "parameters": {
        "url": "=https://aimachristian-pdf.ajcxjb.easypanel.host/api/convert/{{ $json.id }}/download",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer TU_TOKEN_AQUI"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 300000
        }
      },
      "id": "5",
      "name": "Download Word",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Preparar HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar HTML": {
      "main": [
        [
          {
            "node": "Convert HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert HTML": {
      "main": [
        [
          {
            "node": "Esperar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Esperar": {
      "main": [
        [
          {
            "node": "Download Word",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}